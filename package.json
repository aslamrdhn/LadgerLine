    "lucide-react": "^0.546.0",
    "midtrans-client": "^1.4.3",
    "morgan": "^1.11.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-joyride": "^3.1.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
