    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "bullmq": "^5.80.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "idb-keyval": "^6.2.6",
