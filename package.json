{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "node-domexception": "file:./node-domexception-mock"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "npx prisma migrate deploy || true; NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
