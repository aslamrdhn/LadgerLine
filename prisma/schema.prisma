generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  email         String
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  outlets       Outlet[]
  users         User[]
  items         Item[]
  menus         Menu[]
  sales         SalesHeader[]
  journals      JournalEntry[]
  subscriptions Subscription?
  auditLogs     AuditLog[]
  archives      ArchiveManifest[]
  settings      TenantSetting?
  periods       AccountingPeriod[]
  numberSeqs    NumberSequence[]
  numberStats   NumberStatus[]
  warehouses    Warehouse[]
  units         Unit[]
  recipes       Recipe[]
  recipeDetails RecipeDetail[]
  suppliers     Supplier[]
  inventoryLedgers InventoryLedger[]
  inventoryBalances InventoryBalance[]
  fifoLayers    FIFOLayer[]
  fifoConsumptions FIFOConsumption[]
  salesDetails  SalesDetail[]
  payments      Payment[]
  journalLines  JournalLine[]
  accounts      Account[]
}

model User {
  id             String         @id @default(cuid())
  tenantId       String?
  email          String         @unique
  passwordHash   String
  name           String
  role           String
  isSuperAdmin   Boolean        @default(false)
  anonymizedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  sales          SalesHeader[]
  auditLogs      AuditLog[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  maxOutlets    Int
  maxUsers      Int
  price         Decimal        @db.Decimal(12,2)
  features      Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  planId            String
  status            String   @default("ACTIVE")
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  plan              Plan     @relation(fields: [planId], references: [id])
}

model TenantSetting {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  timezone      String   @default("Asia/Jakarta")
  autoCloseHour Int      @default(0)
  softCloseDays Int      @default(7)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Outlet {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  isDefault     Boolean  @default(false)
  address       String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  warehouses    Warehouse[]
  sales         SalesHeader[]
  inventoryLedgers InventoryLedger[]
}

model Warehouse {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  name          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  items         Item[]
  inventoryLedgers InventoryLedger[]
  inventoryBalances InventoryBalance[]
  fifoLayers    FIFOLayer[]
}

model Unit {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  symbol           String
  category         String
  isBase           Boolean  @default(false)
  conversionToBase Decimal  @db.Decimal(12,4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  items            Item[]
  recipeDetails    RecipeDetail[]
}

model Item {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseId   String
  sku           String
  name          String
  category      String
  unitId        String
  purchasePrice Decimal  @db.Decimal(12,2)
  sellPrice     Decimal  @db.Decimal(12,2)
  isMenu        Boolean  @default(false)
  currentStock  Decimal  @default(0) @db.Decimal(12,4)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  unit          Unit     @relation(fields: [unitId], references: [id])
  recipeDetails RecipeDetail[]
  inventoryLedgers InventoryLedger[]
  inventoryBalances InventoryBalance[]
  fifoLayers    FIFOLayer[]
}

model Menu {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  price         Decimal  @db.Decimal(12,2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  recipes       Recipe[]
  salesDetails  SalesDetail[]
}

model Recipe {
  id             String    @id @default(cuid())
  tenantId       String
  menuId         String
  version        Int
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  yieldQty       Decimal   @db.Decimal(12,4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  menu           Menu      @relation(fields: [menuId], references: [id])
  details        RecipeDetail[]
}

model RecipeDetail {
  id            String   @id @default(cuid())
  tenantId      String
  recipeId      String
  itemId        String
  quantity      Decimal  @db.Decimal(12,4)
  unitId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  recipe        Recipe   @relation(fields: [recipeId], references: [id])
  item          Item     @relation(fields: [itemId], references: [id])
  unit          Unit     @relation(fields: [unitId], references: [id])
}

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  category      String?
  contact       String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model InventoryLedger {
  id            String   @id @default(cuid())
  tenantId      String
  outletId      String
  warehouseId   String
  itemId        String
  movementType  String
  referenceType String
  referenceId   String
  businessDate  DateTime
  qtyIn         Decimal  @db.Decimal(12,4)
  qtyOut        Decimal  @db.Decimal(12,4)
  balanceAfter  Decimal  @db.Decimal(12,4)
  unitCost      Decimal  @db.Decimal(12,2)
  costMethod    String
  unitSnapshot  String
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  item          Item     @relation(fields: [itemId], references: [id])
}

model InventoryBalance {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseId   String
  itemId        String
  currentStock  Decimal  @db.Decimal(12,4)
  version       Int      @default(1)
  lastRebuiltAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  item          Item     @relation(fields: [itemId], references: [id])
  
  @@unique([tenantId, warehouseId, itemId])
}

model FIFOLayer {
  id              String   @id @default(cuid())
  tenantId        String
  itemId          String
  warehouseId     String
  quantity        Decimal  @db.Decimal(12,4)
  unitCost        Decimal  @db.Decimal(12,2)
  layerDate       DateTime
  remainingQty    Decimal  @db.Decimal(12,4)
  isExhausted     Boolean  @default(false)
  sourceReference String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  item            Item     @relation(fields: [itemId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  consumptions    FIFOConsumption[]
}

model FIFOConsumption {
  id               String   @id @default(cuid())
  tenantId         String
  layerId          String
  salesId          String
  quantityConsumed Decimal  @db.Decimal(12,4)
  unitCostAtTime   Decimal  @db.Decimal(12,2)
  consumptionDate  DateTime
  createdAt        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  layer            FIFOLayer @relation(fields: [layerId], references: [id])
  sale             SalesHeader @relation(fields: [salesId], references: [id])
}

model SalesHeader {
  id             String   @id @default(cuid())
  tenantId       String
  outletId       String
  invoiceNumber  String   @unique
  businessDate   DateTime
  cashierId      String
  subtotal       Decimal  @db.Decimal(12,2)
  discount       Decimal  @default(0) @db.Decimal(12,2)
  tax            Decimal  @default(0) @db.Decimal(12,2)
  totalAmount    Decimal  @db.Decimal(12,2)
  status         String   @default("DRAFT") // DRAFT, POSTED, LOCKED, REFUNDED
  originalSalesId String?
  idempotencyKey String?  @unique
  postingBatchId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  outlet         Outlet   @relation(fields: [outletId], references: [id])
  user           User     @relation(fields: [cashierId], references: [id])
  originalSale   SalesHeader? @relation("Reversal", fields: [originalSalesId], references: [id])
  reversal       SalesHeader[] @relation("Reversal")
  details        SalesDetail[]
  payments       Payment[]
  fifoConsumptions FIFOConsumption[]
}

model SalesDetail {
  id                    String   @id @default(cuid())
  tenantId              String
  salesId               String
  menuId                String
  menuNameSnapshot      String
  unitPriceSnapshot     Decimal  @db.Decimal(12,2)
  quantity              Decimal  @db.Decimal(12,4)
  totalPrice            Decimal  @db.Decimal(12,2)
  hpp                   Decimal  @db.Decimal(12,2)
  costingMethodSnapshot String
  createdAt             DateTime @default(now())

  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  sale                  SalesHeader @relation(fields: [salesId], references: [id])
  menu                  Menu     @relation(fields: [menuId], references: [id])
}

model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  salesId       String
  method        String
  amount        Decimal  @db.Decimal(12,2)
  status        String   @default("PAID")
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  sale          SalesHeader @relation(fields: [salesId], references: [id])
}

model Account {
  id            String   @id @default(cuid())
  tenantId      String?
  code          String
  name          String
  type          String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  journalLines  JournalLine[]
}

model JournalEntry {
  id            String   @id @default(cuid())
  tenantId      String
  entryNumber   String   @unique
  entryDate     DateTime
  referenceType String
  referenceId   String
  description   String?
  status        String   @default("POSTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  lines         JournalLine[]
}

model JournalLine {
  id            String   @id @default(cuid())
  tenantId      String
  journalId     String
  accountId     String
  debit         Decimal  @db.Decimal(12,2)
  credit        Decimal  @db.Decimal(12,2)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  journal       JournalEntry @relation(fields: [journalId], references: [id])
  account       Account  @relation(fields: [accountId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?
  action        String
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
}

model ArchiveManifest {
  id            String   @id @default(cuid())
  tenantId      String
  reportType    String
  fileName      String
  fileId        String?
  status        String   @default("PENDING")
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model AccountingPeriod {
  id          String   @id @default(cuid())
  tenantId    String
  period      String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("OPEN")
  closedAt    DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model NumberSequence {
  id          String   @id @default(cuid())
  tenantId    String
  prefix      String
  lastNumber  Int      @default(0)
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, prefix, year])
}

model NumberStatus {
  id          String   @id @default(cuid())
  tenantId    String
  number      String
  status      String
  note        String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, number])
}

