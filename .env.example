# URL Koneksi ke Database PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/ladgerline"

# URL Koneksi ke Redis untuk Caching
REDIS_URL="redis://localhost:6379"

# Port untuk server backend
PORT=3000

# Environment (development/production)
NODE_ENV="development"

# Secret untuk JWT Token
JWT_SECRET="supersecret_jwt_key_here"

# Firebase Project ID
FIREBASE_PROJECT_ID="ladgerline-dev"

# Firebase Private Key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client Email
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@ladgerline-dev.iam.gserviceaccount.com"

# Kunci Server Midtrans untuk Payment Gateway
MIDTRANS_SERVER_KEY="SB-Mid-server-..."

# Kunci Klien Midtrans untuk Frontend
MIDTRANS_CLIENT_KEY="SB-Mid-client-..."

# Daftar Origin yang diizinkan untuk CORS (pisahkan dengan koma)
ALLOWED_ORIGINS="http://localhost:5173,https://*.ladgerline.com"
