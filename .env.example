# =========================================================================
# WAJIB DIGANTI, JANGAN PAKAI CONTOH INI DI PRODUKSI
# Pastikan semua credential diganti dengan nilai yang aman dan tidak mudah ditebak
# =========================================================================

# Security & Authentication
JWT_SECRET="your_super_secret_jwt_key_here_must_be_at_least_32_characters"
SUPERADMIN_EMAIL="superadmin@ledgerline.local"
SUPERADMIN_PASSWORD="$2a$10$w8T0C0p.Q..." # Harus menggunakan BCRYPT HASH!
DEFAULT_OWNER_PASSWORD="your_default_owner_password"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledgerline"
REDIS_URL="redis://localhost:6379"

# Third-party Integrations
BREVO_API_KEY=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# System
PORT=3000
NODE_ENV="development"

# Frontend Firebase Config (VITE_ prefixed)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
